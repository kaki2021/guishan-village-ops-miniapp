.container {
  padding: 20rpx 24rpx 120rpx;
  background: #f5f5f0;
  min-height: 100vh;
}
.summary-card {
  background: #1a7a5e;
  border-radius: 20rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  gap: 12rpx;
}
.summary-num {
  font-size: 56rpx;
  font-weight: 500;
  color: #fff;
}
.summary-label {
  font-size: 26rpx;
  color: rgba(255,255,255,0.7);
}
.summary-divider {
  font-size: 36rpx;
  color: rgba(255,255,255,0.4);
}
.summary-total {
  font-size: 56rpx;
  font-weight: 500;
  color: rgba(255,255,255,0.5);
}
.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
  margin: 8rpx 0 16rpx;
}
.ach-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.ach-card {
  width: calc(50% - 8rpx);
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 20rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.ach-card.locked {
  opacity: 0.45;
  filter: grayscale(1);
}
.ach-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}
.ach-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #1a1a1a;
  display: block;
}
.ach-desc {
  font-size: 22rpx;
  color: #888;
  margin-top: 6rpx;
  display: block;
}