  font-size: 25rpx;
}

/* ===== 借款合计条 & 台账 ===== */
.loan-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f2f7ff;
  border: 1rpx solid #cfdcf0;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}
.loan-bar-text { font-size: 26rpx; color: #185fa5; font-weight: 500; }
.loan-bar-arrow { font-size: 23rpx; color: #185fa5; }
.loan-total-bar {
  background: linear-gradient(135deg, #185fa5, #14508c);
  border-radius: 14rpx;
  padding: 22rpx 26rpx;
  margin-bottom: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.loan-total-label { font-size: 22rpx; color: rgba(255,255,255,0.8); }
.loan-total-amt { font-size: 42rpx; color: #fff; font-weight: 600; }
