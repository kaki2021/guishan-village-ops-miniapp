/* ===== 我垫付待还（采购人横幅） ===== */
.myawait-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff7e8;
  border: 1rpx solid #f0d9a8;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}
.myawait-main { font-size: 27rpx; color: #b45309; font-weight: 500; }
.myawait-arrow { font-size: 24rpx; color: #b45309; }
.myawait-panel {
  background: #fffdf7;
  border: 1rpx solid #f0d9a8;
  border-top: none;
  border-radius: 0 0 14rpx 14rpx;
  margin: -22rpx 0 20rpx;
  padding: 14rpx 24rpx 16rpx;
}
.myawait-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5ecd8;
}
.myawait-item:last-of-type { border-bottom: none; }
.myawait-item-left { display: flex; flex-direction: column; gap: 4rpx; flex: 1; margin-right: 16rpx; }
.myawait-item-title { font-size: 26rpx; color: #333; }
.myawait-item-sub { font-size: 22rpx; color: #999; }
.myawait-item-amt { font-size: 27rpx; color: #b45309; font-weight: 600; flex-shrink: 0; }
.myawait-hint { font-size: 21rpx; color: #bba878; text-align: center; padding-top: 10rpx; }

/* ===== 库存：两列卡片（行高自适应、自动换行） ===== */
.item-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  align-items: stretch;   /* 同一行两张卡等高，行与行高度各自适应 */
  margin-bottom: 24rpx;
}
.item-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.item-card-body { flex: 1; display: flex; flex-direction: column; }
.item-body-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}
.item-body-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.item-thumb {
  width: 88rpx;
  height: 88rpx;
  border-radius: 10rpx;
  background: #f5f5f0;
  flex-shrink: 0;
}
.item-thumb-holder {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: 10rpx;
  background: #f7f6f0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.item-thumb-icon { font-size: 44rpx; }
.item-thumb-cam {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  font-size: 22rpx;
  background: #fff;
  border-radius: 50%;
  padding: 2rpx;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.15);
}
.item-card .item-name {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  word-break: break-all;   /* 名字长了自动换行，卡片高度跟着长 */
  line-height: 1.4;
}
.item-card .item-meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 6rpx;
  min-height: 0;
}
.item-card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid #f2f1ea;
}
.item-card-foot .item-qty { font-size: 30rpx; font-weight: 600; color: #333; }

/* ===== 编辑物品：实拍图选择 ===== */
.photo-pick-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}
.photo-pick-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #f5f5f0;
}
.photo-pick-btn {
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  border: 1rpx solid #1a7a5e;
  color: #1a7a5e;
  font-size: 24rpx;
  background: #fff;
}
.photo-pick-btn.del { border-color: #e0e0e0; color: #999; }
.photo-pick-btn.add { border-style: dashed; background: #f7faf9; }

/* ===== 时间戳 & 盘点照片 ===== */
.item-time { font-size: 20rpx; color: #c0beb4; margin-top: 4rpx; }
.stk-last-line { font-size: 22rpx; color: #999; margin: -8rpx 0 16rpx 8rpx; }
.stk-photo-wrap { flex: 1; display: flex; flex-wrap: wrap; gap: 14rpx; }
.stk-photo-cell { position: relative; }
.stk-photo-thumb { width: 110rpx; height: 110rpx; border-radius: 10rpx; background: #f5f5f0; }
.stk-photo-del {
  position: absolute; top: -12rpx; right: -12rpx;
  width: 36rpx; height: 36rpx; line-height: 32rpx; text-align: center;
  border-radius: 50%; background: rgba(0,0,0,0.55); color: #fff; font-size: 24rpx;
}
.stk-photo-add {
  width: 110rpx; height: 110rpx; border-radius: 10rpx;
  border: 2rpx dashed #ccc; display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; background: #fafaf7;
}
.stk-photo-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }

/* ===== 联系人通讯录 ===== */
.purchase-btn-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.purchase-btn-row .add-btn { flex: 1; margin-bottom: 0; }
.contact-entry {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 22rpx;
  border-radius: 14rpx;
  border: 1rpx solid #d8e5df;
  background: #fff;
  font-size: 30rpx;
}
.contact-entry-txt { font-size: 20rpx; color: #1a7a5e; }
.contact-toolbar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 16rpx;
}
.contact-search {
  flex: 1;
  background: #f5f4ee;
  border-radius: 999rpx;
  padding: 12rpx 26rpx;
  font-size: 26rpx;
}
.contact-add-btn {
  flex-shrink: 0;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: #1a7a5e;
  color: #fff;
  font-size: 25rpx;
}
.contact-tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.contact-tag-chip {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid #e0e0e0;
  font-size: 23rpx;
  color: #888;
  background: #fff;
}
.contact-tag-chip.active {
  background: #e8f5f0;
