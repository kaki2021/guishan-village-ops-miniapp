    <view class="form-row">
      <text class="form-label">实拍图</text>
      <view class="photo-pick-wrap">
        <block wx:if="{{editPhotoUrl}}">
          <image class="photo-pick-thumb" src="{{editPhotoUrl}}" mode="aspectFill" bindtap="previewEditPhoto"/>
