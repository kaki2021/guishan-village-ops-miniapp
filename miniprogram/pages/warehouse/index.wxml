<!-- 采购：核验弹窗 -->
<view class="modal-mask" wx:if="{{showVerifyModal}}" bindtap="hideVerify">
  <view class="modal" catchtap="noop">
    <view class="modal-title">核验票与物</view>
    <view class="readonly-row"><text class="readonly-label">物品</text><text class="readonly-value">{{verifyItemsText}}</text></view>
    <view class="screenshot-row" wx:if="{{verifyReceipts.length > 0}}">
      <text class="screenshot-label">凭证</text>
      <view class="screenshot-picker">
        <view class="screenshot-item readonly" wx:for="{{verifyReceiptUrls}}" wx:key="*this">
          <image class="screenshot-img" src="{{item}}" mode="aspectFill" bindtap="previewVerifyReceipt" data-index="{{index}}"/>
        </view>
      </view>
    </view>
    <view class="export-hint">核对实物与凭证是否一致；通过后进入入库确认。</view>
    <view class="pc-verify-btns">
      <button class="submit-btn pc-half danger-btn" bindtap="verifyReject">退回</button>
      <button class="submit-btn pc-half" bindtap="verifyPass">核验通过</button>
    </view>
  </view>
</view>

<!-- 采购：入库确认弹窗 -->
<view class="modal-mask" wx:if="{{showStockInModal}}" bindtap="hideStockIn">
  <view class="modal" catchtap="noop">
    <view class="modal-title">确认入库（逐项核对实收）</view>
    <view class="form-row form-row-wrap">
      <text class="form-label">入到</text>
      <view class="type-list">
        <view class="type-tag active">{{siSiteName || '指定地方'}}</view>
      </view>
    </view>
    <view class="form-row form-row-wrap">
      <text class="form-label">分库</text>
      <view class="type-list">
        <view class="type-tag {{siStoreId===st.id?'active':''}}"
          wx:for="{{siStoreTabs}}" wx:key="id" wx:for-item="st"
          bindtap="setSiStore" data-id="{{st.id}}">{{st.name}}</view>
        <text class="store-empty-inline" wx:if="{{siStoreTabs.length === 0}}">该地方无分库</text>
      </view>
    </view>
    <view class="si-row" wx:for="{{stockInItems}}" wx:key="index" wx:for-item="it">
      <view class="si-line">
        <text class="si-name">{{it.name}}<text class="si-spec" wx:if="{{it.spec}}"> · {{it.spec}}</text></text>
        <text class="si-new" wx:if="{{it.isNew}}">新物品</text>
      </view>
      <view class="si-line">
        <text class="si-sub">应到 {{it.qty}}，实收</text>
        <input class="form-input si-qty" type="number" data-index="{{index}}" bindinput="setStockInQty" value="{{it.receivedQty}}"/>
      </view>
      <view class="si-new-fields" wx:if="{{it.isNew}}">
        <view class="type-list">
          <view class="type-tag {{it.category===c?'active':''}}"
            wx:for="{{categories}}" wx:key="*this" wx:for-item="c"
            catchtap="setStockInCategory" data-index="{{index}}" data-val="{{c}}">{{c}}</view>
        </view>
        <input class="form-input si-icon" placeholder="图标 emoji" data-index="{{index}}" bindinput="setStockInIcon" value="{{it.icon}}"/>
      </view>
    </view>
    <view class="export-hint">入库只更新库存，不动金库；完成后生成「待记账」交账房先生。</view>
    <button class="submit-btn" bindtap="submitStockIn">确认入库</button>
  </view>
</view>

<!-- 管理库房弹窗（增删改 地方/分库） -->
<view class="modal-mask" wx:if="{{showManageModal}}" bindtap="hideManageModal">
  <view class="modal" catchtap="noop">
    <view class="modal-title">管理库房</view>
    <view class="export-hint">地方下分库；有物品的不能删，先移走或清空</view>

    <view class="mg-site" wx:for="{{tree.sites}}" wx:key="id" wx:for-item="s">
      <view class="mg-site-head">
        <text class="mg-site-name">{{s.name}}</text>
        <view class="mg-ops">
          <text class="mg-op" catchtap="addStoreAction" data-siteid="{{s.id}}">+分库</text>
          <text class="mg-op" catchtap="renameNodeAction" data-kind="site" data-id="{{s.id}}" data-name="{{s.name}}">改名</text>
          <text class="mg-op danger" catchtap="removeNodeAction" data-kind="site" data-id="{{s.id}}" data-name="{{s.name}}">删</text>
        </view>
      </view>
      <view class="mg-store" wx:for="{{s.stores}}" wx:key="id" wx:for-item="st">
        <text class="mg-store-name">— {{st.name}}</text>
        <view class="mg-ops">
          <text class="mg-op" catchtap="renameNodeAction" data-kind="store" data-id="{{st.id}}" data-name="{{st.name}}">改名</text>
          <text class="mg-op danger" catchtap="removeNodeAction" data-kind="store" data-id="{{st.id}}" data-name="{{st.name}}">删</text>
        </view>
      </view>
      <view class="mg-store-empty" wx:if="{{s.stores.length === 0}}">— 暂无分库</view>
