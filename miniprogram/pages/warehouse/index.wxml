      </view>
    </view>
    <view class="form-row form-row-wrap">
      <text class="form-label">地方</text>
      <view class="type-list">
        <view class="type-tag {{editSiteId===s.id?'active':''}}"
          wx:for="{{tree.sites}}" wx:key="id" wx:for-item="s"
          bindtap="setEditSite" data-id="{{s.id}}">{{s.name}}</view>
      </view>
    </view>
    <view class="form-row form-row-wrap">
      <text class="form-label">分库</text>
      <view class="type-list">
        <view class="type-tag {{editStoreId===st.id?'active':''}}"
          wx:for="{{editStoreTabs}}" wx:key="id" wx:for-item="st"
          bindtap="setEditStore" data-id="{{st.id}}">{{st.name}}</view>
        <text class="store-empty-inline" wx:if="{{editStoreTabs.length === 0}}">该地方无分库</text>
      </view>
    </view>
    <view class="form-row">
      <text class="form-label">预警值</text>
      <input class="form-input" placeholder="库存低于此值显示警告，默认3" type="number"
        bindinput="setEditItemField" data-field="editItemThreshold" value="{{editItemThreshold}}"/>
    </view>
    <view class="form-row form-row-wrap">
      <text class="form-label">领用方式</text>
      <view class="type-list">
        <view class="type-tag {{editConsumeMode==='instant'?'active':''}}" bindtap="setEditConsumeMode" data-val="instant">即时消耗</view>
        <view class="type-tag {{editConsumeMode==='requisition'?'active':''}}" bindtap="setEditConsumeMode" data-val="requisition">领用免审</view>
