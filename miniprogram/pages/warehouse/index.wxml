  </view>
</view>

<!-- ============ 采购：发起 / 重提弹窗 ============ -->
<view class="modal-mask" wx:if="{{showPurchaseModal}}" bindtap="hidePurchaseModal">
  <view class="modal" catchtap="noop">
    <view class="modal-title">{{pEditId ? '修改后重新提交' : '发起采购申请'}}</view>
    <view class="form-row">
      <text class="form-label">给哪</text>
      <text class="form-input" style="display:flex;align-items:center;">{{pSiteName || '未指定'}}</text>
    </view>
    <view class="form-row">
      <text class="form-label">类型</text>
      <view class="pkind-options">
        <view class="pkind-option {{pKind==='general'?'active':''}}" bindtap="setPKind" data-val="general">📦 物资</view>
        <view class="pkind-option {{pKind==='food'?'active':''}}" bindtap="setPKind" data-val="food">🍚 食材</view>
      </view>
    </view>
    <view class="form-row">
      <text class="form-label">用途</text>
      <input class="form-input" placeholder="如：周末露营补给" bindinput="setPField" data-field="pTitle" value="{{pTitle}}"/>
    </view>

    <view class="pc-items-head">物品（名称 / 规格 / 数量）</view>
    <view class="pc-item-edit" wx:for="{{pItems}}" wx:key="index" wx:for-item="it">
      <input class="form-input pc-ie-name" placeholder="名称" data-index="{{index}}" data-field="name" bindinput="setPItemField" value="{{it.name}}"/>
      <input class="form-input pc-ie-spec" placeholder="规格" data-index="{{index}}" data-field="spec" bindinput="setPItemField" value="{{it.spec}}"/>
      <input class="form-input pc-ie-qty" placeholder="数量" type="number" data-index="{{index}}" data-field="qty" bindinput="setPItemField" value="{{it.qty}}"/>
      <view class="pc-ie-del" catchtap="removePItemRow" data-index="{{index}}">×</view>
      <text class="pc-ie-stock {{it.stockLow ? 'low' : ''}}" wx:if="{{it.stockChecked}}">{{it.stockHas ? ('库里现有 ' + it.stockQty + ' 件' + (it.stockLow ? '（偏低）' : '')) : '库里暂无同名物品'}}</text>
    </view>
    <view class="add-type-link" bindtap="addPItemRow">+ 再加一项</view>

    <view class="form-row">
      <text class="form-label">预算</text>
      <input class="form-input" placeholder="可选，如 200" type="digit" bindinput="setPField" data-field="pBudget" value="{{pBudget}}"/>
    </view>
    <view class="form-row">
      <text class="form-label">备注</text>
      <input class="form-input" placeholder="可选" bindinput="setPField" data-field="pReason" value="{{pReason}}"/>
    </view>
    <button class="submit-btn" bindtap="submitPurchase">{{pEditId ? '重新提交' : '提交待审批'}}</button>
  </view>
</view>

<!-- 采购：详情弹窗 -->
