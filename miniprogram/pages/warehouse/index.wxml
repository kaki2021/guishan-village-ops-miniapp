          <view class="photo-pick-btn del" bindtap="removeItemPhoto">删除</view>
        </block>
        <view class="photo-pick-btn add" wx:else bindtap="chooseItemPhoto">📷 拍照 / 选图</view>
      </view>
    </view>
    <view class="form-row">
