      <view class="recyclable-toggle {{scrapRecyclable?'on':''}}" bindtap="toggleScrapRecyclable">{{scrapRecyclable ? '可回收' : '不可回收'}}</view>
    </view>
    <view class="export-hint">提交后需主管批准才核销扣库存</view>
    <button class="submit-btn" bindtap="submitScrap">提交报废</button>
  </view>
</view>

<!-- 发起盘点弹窗 -->
<view class="modal-mask" wx:if="{{showStkModal}}" bindtap="hideStkModal">
  <view class="modal" catchtap="noop">
    <view class="modal-title">发起盘点</view>
    <view class="form-row form-row-wrap">
      <text class="form-label">地方</text>
      <view class="type-list">
        <view class="type-tag {{stkSiteId===s.id?'active':''}}"
          wx:for="{{tree.sites}}" wx:key="id" wx:for-item="s"
          bindtap="setStkSite" data-id="{{s.id}}">{{s.name}}</view>
      </view>
    </view>
    <view class="form-row form-row-wrap">
      <text class="form-label">分库</text>
      <view class="type-list">
        <view class="type-tag {{stkStoreId===st.id?'active':''}}"
          wx:for="{{stkStoreTabs}}" wx:key="id" wx:for-item="st"
          bindtap="setStkStore" data-id="{{st.id}}">{{st.name}}</view>
        <text class="store-empty-inline" wx:if="{{stkStoreTabs.length === 0}}">该地方无分库</text>
      </view>
    </view>

    <view class="req-pick-head">填实际数（账实一致的不用改）</view>
    <view class="req-empty" wx:if="{{stkItems.length === 0}}">这个分库暂无物品</view>
    <view class="req-pick-row" wx:for="{{stkItems}}" wx:key="id" wx:for-item="it">
      <view class="req-pick-info">
        <text class="req-pick-name">{{it.name}}</text>
        <text class="req-pick-avail">账面 {{it.systemQty}}</text>
      </view>
      <input class="form-input req-pick-qty" type="number" data-index="{{index}}" bindinput="setStkActual" value="{{it.actual}}"/>
    </view>

    <view class="form-row form-row-wrap" wx:if="{{stkItems.length > 0}}">
      <text class="form-label">现场照片</text>
      <view class="stk-photo-wrap">
        <view class="stk-photo-cell" wx:for="{{stkPhotos}}" wx:key="*this" wx:for-item="p" wx:for-index="pi">
          <image class="stk-photo-thumb" src="{{p}}" mode="aspectFill" bindtap="previewStkLocal" data-index="{{pi}}"/>
          <view class="stk-photo-del" catchtap="removeStkPhoto" data-index="{{pi}}">×</view>
        </view>
        <view class="stk-photo-add" wx:if="{{stkPhotos.length < 6}}" bindtap="chooseStkPhoto">📷</view>
      </view>
    </view>
    <view class="export-hint" wx:if="{{stkItems.length > 0}}">提交后实际数为准，差异项自动修正账面并留痕；照片选填，最多6张</view>
    <button class="submit-btn" wx:if="{{stkItems.length > 0}}" bindtap="submitStocktake">提交盘点</button>
  </view>
</view>

<!-- ===== 联系人通讯录 ===== -->
<view class="modal-mask" wx:if="{{showContactModal}}" bindtap="hideContacts">
  <view class="modal" catchtap="noop">
    <view class="modal-title">📇 常用联系人</view>
    <view class="contact-toolbar">
      <input class="contact-search" placeholder="搜姓名/标签/电话" bindinput="setContactKw" value="{{contactKw}}"/>
      <view class="contact-add-btn" bindtap="showContactEditModal">+ 新增</view>
    </view>
    <view class="contact-tag-row" wx:if="{{contactTags.length > 0}}">
      <view class="contact-tag-chip {{contactTagFilter===t?'active':''}}"
            wx:for="{{contactTags}}" wx:key="*this" wx:for-item="t"
            bindtap="setContactTag" data-val="{{t}}">{{t}}</view>
    </view>
    <view class="pending-empty" wx:if="{{contactsFiltered.length === 0}}">还没有联系人，点「+ 新增」记一个</view>
    <scroll-view scroll-y style="max-height:56vh">
      <view class="contact-card" wx:for="{{contactsFiltered}}" wx:key="_id" wx:for-item="c"
            bindlongpress="showContactEditModal" data-id="{{c._id}}">
        <view class="contact-main">
          <view class="contact-name-line">
            <text class="contact-name">{{c.name}}</text>
            <text class="contact-tag" wx:if="{{c.tag}}">{{c.tag}}</text>
          </view>
          <text class="contact-note" wx:if="{{c.note}}">{{c.note}}</text>
        </view>
        <view class="contact-actions">
          <view class="contact-act" wx:if="{{c.phone}}" catchtap="callContact" data-phone="{{c.phone}}">📞 {{c.phone}}</view>
          <view class="contact-act wechat" wx:if="{{c.wechat}}" catchtap="copyContactWechat" data-wechat="{{c.wechat}}">💬 {{c.wechat}}</view>
        </view>
      </view>
      <view class="contact-hint" wx:if="{{contactsFiltered.length > 0}}">点电话直接拨打 · 点微信号复制 · 长按编辑</view>
    </scroll-view>
  </view>
</view>

<!-- 联系人编辑 -->
<view class="modal-mask" wx:if="{{showContactEdit}}" bindtap="hideContactEdit">
  <view class="modal" catchtap="noop">
    <view class="modal-title">{{cEditId ? '编辑联系人' : '新增联系人'}}</view>
    <view class="form-row">
      <text class="form-label">称呼</text>
      <input class="form-input" placeholder="如：菜市场王姐" bindinput="setCField" data-field="cName" value="{{cName}}"/>
    </view>
    <view class="form-row">
      <text class="form-label">标签</text>
      <input class="form-input" placeholder="如：买菜 / 建材 / 维修" bindinput="setCField" data-field="cTag" value="{{cTag}}"/>
    </view>
    <view class="form-row">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" placeholder="选填" bindinput="setCField" data-field="cPhone" value="{{cPhone}}"/>
    </view>
    <view class="form-row">
      <text class="form-label">微信号</text>
      <input class="form-input" placeholder="选填" bindinput="setCField" data-field="cWechat" value="{{cWechat}}"/>
    </view>
    <view class="form-row">
      <text class="form-label">备注</text>
      <input class="form-input" placeholder="如：只送到山脚，周一休" bindinput="setCField" data-field="cNote" value="{{cNote}}"/>
    </view>
    <button class="submit-btn" bindtap="submitContact">保存</button>
    <view class="contact-del-btn" wx:if="{{cEditId}}" bindtap="deleteContact">删除该联系人</view>
  </view>
</view>
