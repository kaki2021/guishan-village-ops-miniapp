    <view class="modal-title">报废报损</view>
    <view class="form-row">
      <text class="form-label">物品</text>
      <text class="form-value-readonly">{{scrapItem.name}}（库存 {{scrapItem.avail}}）</text>
    </view>
    <view class="form-row">
      <text class="form-label">报废数量</text>
