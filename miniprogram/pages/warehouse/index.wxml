    <view class="form-row form-row-wrap">
      <text class="form-label">地方</text>
      <view class="type-list">
        <view class="type-tag {{reqSiteId===s.id?'active':''}}"
          wx:for="{{tree.sites}}" wx:key="id" wx:for-item="s"
          bindtap="setReqSite" data-id="{{s.id}}">{{s.name}}</view>
      </view>
    </view>
    <view class="form-row form-row-wrap">
      <text class="form-label">分库</text>
      <view class="type-list">
        <view class="type-tag {{reqStoreId===st.id?'active':''}}"
          wx:for="{{reqStoreTabs}}" wx:key="id" wx:for-item="st"
          bindtap="setReqStore" data-id="{{st.id}}">{{st.name}}</view>
        <text class="store-empty-inline" wx:if="{{reqStoreTabs.length === 0}}">该地方无分库</text>
      </view>
    </view>

