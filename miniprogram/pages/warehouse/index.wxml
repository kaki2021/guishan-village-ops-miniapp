      <input class="form-input" bindinput="setEditItemField" data-field="editItemName" value="{{editItemName}}"/>
    </view>
    <view class="form-row form-row-wrap">
      <text class="form-label">分类</text>
      <view class="type-list">
        <view class="type-tag {{editItemCategory===item?'active':''}}"
          wx:for="{{categories}}" wx:key="*this" wx:for-item="item"
