<view class="container">
  <!-- 顶部 tab 切换 -->
  <view class="wh-tabs">
    <view class="wh-tab {{activeTab==='stock'?'active':''}}" bindtap="switchTab" data-tab="stock">库存</view>
    <view class="wh-tab {{activeTab==='purchase'?'active':''}}" bindtap="switchTab" data-tab="purchase">采购</view>
    <view class="wh-tab {{activeTab==='requisition'?'active':''}}" bindtap="switchTab" data-tab="requisition">领料</view>
    <view class="wh-tab {{activeTab==='stocktake'?'active':''}}" bindtap="switchTab" data-tab="stocktake">盘点</view>
  </view>

  <!-- ============ 库存视图 ============ -->
  <block wx:if="{{activeTab==='stock'}}">
    <view class="add-btn-wrap" wx:if="{{iCanManageStock}}">
      <button class="add-btn" bindtap="showAddModal">+ 记录补给 / 消耗</button>
      <button class="add-btn ai" bindtap="openAiModal">🤖 AI 帮填入库</button>
    </view>

    <!-- 地方 tab -->
    <scroll-view class="store-nav" scroll-x>
      <view class="store-nav-tag {{currentSiteId===s.id?'active':''}}"
        wx:for="{{siteTabs}}" wx:key="id" wx:for-item="s"
        bindtap="selectSite" data-id="{{s.id}}">{{s.name}}</view>
      <view class="store-nav-manage" bindtap="openManageModal">⚙︎ 管理</view>
    </scroll-view>
    <!-- 分库 tab -->
    <scroll-view class="store-nav sub" scroll-x wx:if="{{storeTabs.length > 0}}">
      <view class="store-nav-tag sub {{currentStoreId===st.id?'active':''}}"
        wx:for="{{storeTabs}}" wx:key="id" wx:for-item="st"
        bindtap="selectStore" data-id="{{st.id}}">{{st.name}}</view>
    </scroll-view>
    <view class="store-empty-hint" wx:if="{{currentSiteId!=='__none__' && storeTabs.length === 0}}">这个地方还没有分库，点「⚙︎ 管理」添加</view>
    <view class="stk-last-line" wx:if="{{currentStoreId && currentStoreId !== '__none__'}}">上次盘点：{{stkTimeByStore[currentStoreId] || '还没盘过'}}</view>

    <block wx:if="{{items.length === 0}}">
      <view class="empty-tip">这个分库暂无物资</view>
    </block>

    <block wx:else>
      <block wx:for="{{groupedItems}}" wx:key="category" wx:for-item="group">
        <view class="section-title">{{group.icon}} {{group.category}}</view>
        <view class="item-grid">
          <view class="item-card" wx:for="{{group.items}}" wx:key="_id" wx:for-item="item">
            <!-- 卡片主体：长按编辑（图片位已预留：有实拍图显示图，没有显示图标） -->
            <view class="item-card-body"
              bindlongpress="longPressItem"
              data-id="{{item._id}}"
              data-name="{{item.name}}"
              data-icon="{{item.icon}}"
              data-category="{{item.category}}"
              data-threshold="{{item.lowThreshold}}">
              <view class="item-body-row">
                <image class="item-thumb" wx:if="{{item.photoUrl}}" src="{{item.photoUrl}}" mode="aspectFill" catchtap="previewItemPhoto" data-url="{{item.photoUrl}}"/>
                <view class="item-thumb-holder" wx:else catchtap="addPhotoFast" data-id="{{item._id}}">
                  <text class="item-thumb-icon">{{item.icon}}</text>
                  <text class="item-thumb-cam" wx:if="{{iCanManageStock}}">📷</text>
                </view>
                <view class="item-body-info">
                  <text class="item-name">{{item.name}}</text>
                  <view class="item-meta-row">
                    <text class="item-warn" wx:if="{{item.qty <= item.lowThreshold}}">库存偏低</text>
                    <text class="item-operator" wx:if="{{item.lastOperator}}">{{item.lastOperator}} 更新</text>
                  </view>
                  <text class="item-time" wx:if="{{item.updateTimeText}}">{{item.updateTimeText}}</text>
                </view>
              </view>
            </view>
            <view class="item-card-foot" wx:if="{{item.isInstant && iCanManageStock}}">
              <view class="item-btn item-plus"
                bindtap="quickPlus" bindlongpress="longPressQty"
                data-name="{{item.name}}" data-type="in">+1</view>
              <text class="item-qty">{{item.qty}}</text>
              <view class="item-btn item-minus"
                bindtap="quickMinus" bindlongpress="longPressQty"
                data-name="{{item.name}}" data-qty="{{item.qty}}" data-type="out">-1</view>
            </view>
            <view class="item-card-foot" wx:elif="{{item.isInstant}}">
              <text class="item-qty">{{item.qty}}</text>
            </view>
            <view class="item-card-foot" wx:else>
              <text class="item-mode-tag {{item.consumeMode==='approval'?'approval':''}}">{{item.modeLabel}}</text>
              <text class="item-qty">{{item.qty}}</text>
            </view>
          </view>
        </view>
      </block>
    </block>
  </block>

  <!-- ============ 采购视图 ============ -->
  <block wx:if="{{activeTab==='purchase'}}">
    <view class="add-btn-wrap">
      <view class="purchase-btn-row">
        <button class="add-btn" bindtap="showPurchaseModal">+ 发起采购</button>
        <view class="contact-entry" bindtap="openContacts">📇<text class="contact-entry-txt">联系人</text></view>
      </view>
    </view>

    <!-- 我垫付待还：采购人视角，一眼看到几单多少钱还没还（没有则不显示） -->
    <view class="myawait-banner" wx:if="{{myAwaitCount > 0}}" bindtap="toggleMyAwait">
      <text class="myawait-main">💰 我垫付待还：{{myAwaitCount}} 单 · ¥{{myAwaitTotal}}</text>
      <text class="myawait-arrow">{{myAwaitOpen ? '▴' : '▾'}}</text>
    </view>
    <view class="myawait-panel" wx:if="{{myAwaitCount > 0 && myAwaitOpen}}">
      <view class="myawait-item" wx:for="{{myAwaitList}}" wx:key="_id" wx:for-item="a">
        <view class="myawait-item-left">
          <text class="myawait-item-title">{{a.title}}</text>
          <text class="myawait-item-sub">{{a.timeText}} · {{a.stageLabel}}</text>
        </view>
        <text class="myawait-item-amt">¥{{a.amountDisplay}}</text>
      </view>
      <view class="myawait-hint">入库并由账房记账后即还清，此处自动消失</view>
    </view>

    <!-- 类型切换：全部 / 物资 / 食材 -->
    <view class="sub-switch">
      <view class="sub-switch-tag {{pKindFilter==='all'?'active':''}}" bindtap="setPKindFilter" data-val="all">全部</view>
      <view class="sub-switch-tag {{pKindFilter==='general'?'active':''}}" bindtap="setPKindFilter" data-val="general">📦 物资</view>
      <view class="sub-switch-tag {{pKindFilter==='food'?'active':''}}" bindtap="setPKindFilter" data-val="food">🍚 食材</view>
    </view>

    <view class="ledger-filter-row">
      <view class="ledger-filter-tag {{purchaseFilter==='todo'?'active':''}}" bindtap="setPurchaseFilter" data-val="todo">进行中</view>
      <view class="ledger-filter-tag {{purchaseFilter==='done'?'active':''}}" bindtap="setPurchaseFilter" data-val="done">已完成</view>
      <view class="ledger-filter-tag {{purchaseFilter==='all'?'active':''}}" bindtap="setPurchaseFilter" data-val="all">全部</view>
    </view>

    <!-- 时间区间（按发起时间，可只填一头，都空=不限） -->
    <view class="ptime-range">
      <text class="ptime-range-label">🕐</text>
      <picker mode="date" value="{{pRangeStart}}" end="{{pRangeEnd}}" bindchange="setPRangeStart">
        <view class="ptime-range-pick {{pRangeStart?'set':''}}">{{pRangeStart || '起始日期'}}</view>
      </picker>
      <text class="ptime-range-sep">~</text>
      <picker mode="date" value="{{pRangeEnd}}" start="{{pRangeStart}}" bindchange="setPRangeEnd">
        <view class="ptime-range-pick {{pRangeEnd?'set':''}}">{{pRangeEnd || '结束日期'}}</view>
      </picker>
      <view class="ptime-range-clear" wx:if="{{pRangeStart || pRangeEnd}}" bindtap="clearPRange">×</view>
    </view>

    <!-- 状态细筛：只列当前有单的状态，带数量（换行平铺，全部可见） -->
    <view class="pstatus-wrap" wx:if="{{pStatusChips.length > 2}}">
      <view class="pstatus-chip {{pStatusFilter===c.val?'active':''}}"
            wx:for="{{pStatusChips}}" wx:key="val" wx:for-item="c"
            bindtap="setPStatusFilter" data-val="{{c.val}}">
        {{c.label}}<text class="pstatus-count">{{c.count}}</text>
      </view>
    </view>

    <view class="empty-tip" wx:if="{{purchasesFiltered.length === 0}}">该分类下暂无采购单</view>

    <view class="pc-card" wx:for="{{purchasesFiltered}}" wx:key="_id" wx:for-item="p">
      <view class="pc-head" bindtap="tapPurchase" data-item="{{p}}">
        <view class="pc-head-left">
          <view class="pc-title-line">
            <text class="pc-kind-tag" wx:if="{{p.isFood}}">🍚 食材</text>
            <text class="pc-title">{{p.title || p.itemSummary || '采购单'}}</text>
          </view>
          <text class="pc-items">{{p.itemSummary}}</text>
        </view>
        <view class="pc-badge {{p.statusClass}}">{{p.statusLabel}}</view>
      </view>

      <view class="pc-meta" bindtap="tapPurchase" data-item="{{p}}">
        <text wx:if="{{p.timeText}}" class="pc-time">{{p.timeText}}</text>
        <text wx:if="{{p.initiatorName}}"> · 发起 {{p.initiatorName}}</text>
        <text wx:if="{{p.buyerName}}"> · 采购 {{p.buyerName}}</text>
        <text wx:if="{{p.budget}}"> · 预算 ¥{{p.budget}}</text>
        <text wx:if="{{p.actualAmount}}"> · 实付 ¥{{p.actualAmount}}</text>
        <text class="pc-ledger {{p.ledgerLabel==='待记账'?'pending':''}}" wx:if="{{p.ledgerLabel}}"> · {{p.ledgerLabel}}</text>
      </view>

      <view class="pc-sign" wx:if="{{p.signLabel}}">需双签：{{p.signLabel}}</view>

      <view class="pc-reject" wx:if="{{p.status==='rejected' && p.rejectReason}}">驳回原因：{{p.rejectReason}}</view>

      <!-- 角色感知操作按钮 -->
      <view class="pc-actions">
        <view class="pc-btn primary" wx:if="{{p.canApprove}}" catchtap="approvePurchase" data-id="{{p._id}}">签字通过</view>
        <view class="pc-btn danger" wx:if="{{p.canApprove}}" catchtap="rejectPurchase" data-id="{{p._id}}">驳回</view>
        <view class="pc-btn primary" wx:if="{{p.canClaim}}" catchtap="claimPurchase" data-id="{{p._id}}">我来认领</view>
        <view class="pc-btn primary" wx:if="{{p.canReport}}" catchtap="openReport" data-item="{{p}}">去报账</view>
        <view class="pc-btn primary" wx:if="{{p.canVerify}}" catchtap="openVerify" data-item="{{p}}">核验</view>
        <view class="pc-btn primary" wx:if="{{p.canStockIn}}" catchtap="openStockIn" data-item="{{p}}">确认入库</view>
        <view class="pc-btn ghost" wx:if="{{p.canEdit}}" catchtap="resubmitPurchase" data-item="{{p}}">编辑</view>
        <view class="pc-btn danger-ghost" wx:if="{{p.canDelete}}" catchtap="deletePurchase" data-id="{{p._id}}">删除</view>
      </view>
    </view>
  </block>

  <!-- ============ 领料视图 ============ -->
  <block wx:if="{{activeTab==='requisition'}}">
    <!-- 领料 / 报废 子切换 -->
    <view class="sub-switch">
      <view class="sub-switch-tag {{reqSubTab==='requisition'?'active':''}}" bindtap="switchReqSubTab" data-tab="requisition">领料出库</view>
      <view class="sub-switch-tag {{reqSubTab==='scrap'?'active':''}}" bindtap="switchReqSubTab" data-tab="scrap">报废报损</view>
    </view>

    <!-- 领料子区 -->
    <block wx:if="{{reqSubTab==='requisition'}}">
      <view class="add-btn-wrap">
        <button class="add-btn" bindtap="openReqModal">+ 发起领料</button>
      </view>

      <view class="ledger-filter-row">
        <view class="ledger-filter-tag {{reqFilter==='todo'?'active':''}}" bindtap="setReqFilter" data-val="todo">进行中</view>
        <view class="ledger-filter-tag {{reqFilter==='done'?'active':''}}" bindtap="setReqFilter" data-val="done">已出库</view>
        <view class="ledger-filter-tag {{reqFilter==='all'?'active':''}}" bindtap="setReqFilter" data-val="all">全部</view>
      </view>

      <view class="empty-tip" wx:if="{{requisitionsFiltered.length === 0}}">该分类下暂无领料单</view>

      <view class="pc-card" wx:for="{{requisitionsFiltered}}" wx:key="_id" wx:for-item="r">
        <view class="pc-head">
          <view class="pc-head-left">
            <text class="pc-title">{{r.itemSummary}}</text>
            <text class="pc-items" wx:if="{{r.reason}}">用途：{{r.reason}}</text>
          </view>
          <view class="pc-badge {{r.statusClass}}">{{r.statusLabel}}</view>
        </view>
        <view class="pc-meta">
          <text wx:if="{{r.applicantName}}">领用 {{r.applicantName}}</text>
          <text wx:if="{{r.approverName}}"> · 审批 {{r.approverName}}</text>
          <text wx:if="{{r.delivererName}}"> · 发货 {{r.delivererName}}</text>
          <text wx:if="{{!r.needApproval}}"> · 免审</text>
        </view>
        <view class="pc-reject" wx:if="{{r.status==='rejected' && r.rejectReason}}">驳回原因：{{r.rejectReason}}</view>
        <view class="pc-actions">
          <view class="pc-btn primary" wx:if="{{r.canApprove}}" catchtap="approveReq" data-id="{{r._id}}">通过</view>
          <view class="pc-btn danger" wx:if="{{r.canApprove}}" catchtap="rejectReq" data-id="{{r._id}}">驳回</view>
          <view class="pc-btn primary" wx:if="{{r.canDeliver}}" catchtap="deliverReq" data-id="{{r._id}}">确认发货</view>
          <view class="pc-btn danger-ghost" wx:if="{{r.canDelete}}" catchtap="deleteReq" data-id="{{r._id}}">删除</view>
        </view>
      </view>
    </block>

    <!-- 报废子区 -->
    <block wx:if="{{reqSubTab==='scrap'}}">
      <view class="export-hint">报废从「库存」里长按物品发起；这里看进度、主管审批</view>
      <view class="empty-tip" wx:if="{{scrapsFiltered.length === 0}}">暂无报废单</view>
      <view class="pc-card" wx:for="{{scrapsFiltered}}" wx:key="_id" wx:for-item="r">
        <view class="pc-head">
          <view class="pc-head-left">
            <text class="pc-title">{{r.name}}×{{r.qty}}</text>
            <text class="pc-items">{{r.reason}}{{r.reasonNote ? '：' + r.reasonNote : ''}} · {{r.recyclableLabel}}</text>
          </view>
          <view class="pc-badge {{r.statusClass}}">{{r.statusLabel}}</view>
        </view>
        <view class="pc-meta">
          <text wx:if="{{r.applicantName}}">报废 {{r.applicantName}}</text>
          <text wx:if="{{r.approverName}}"> · 审批 {{r.approverName}}</text>
        </view>
        <view class="pc-reject" wx:if="{{r.status==='rejected' && r.rejectReason}}">驳回原因：{{r.rejectReason}}</view>
        <view class="pc-actions">
          <view class="pc-btn primary" wx:if="{{r.canApprove}}" catchtap="approveScrap" data-id="{{r._id}}">批准核销</view>
          <view class="pc-btn danger" wx:if="{{r.canApprove}}" catchtap="rejectScrap" data-id="{{r._id}}">驳回</view>
          <view class="pc-btn danger-ghost" wx:if="{{r.canDelete}}" catchtap="deleteScrap" data-id="{{r._id}}">删除</view>
        </view>
      </view>
    </block>
  </block>

  <!-- ============ 盘点视图 ============ -->
  <block wx:if="{{activeTab==='stocktake'}}">
    <view class="sub-switch">
      <view class="sub-switch-tag {{stkSubTab==='take'?'active':''}}" bindtap="switchStkSubTab" data-tab="take">盘点</view>
      <view class="sub-switch-tag {{stkSubTab==='logs'?'active':''}}" bindtap="switchStkSubTab" data-tab="logs">操作记录</view>
    </view>

    <!-- 盘点子区 -->
    <block wx:if="{{stkSubTab==='take'}}">
      <view class="add-btn-wrap">
        <button class="add-btn" bindtap="openStkModal">+ 发起盘点</button>
      </view>
      <view class="empty-tip" wx:if="{{stocktakes.length === 0}}">还没有盘点记录</view>
      <view class="pc-card" wx:for="{{stocktakes}}" wx:key="_id" wx:for-item="s">
        <view class="pc-head">
          <view class="pc-head-left">
            <text class="pc-title">{{s.storeName}}</text>
            <text class="pc-items">盘 {{s.total}} 项 · {{s.diffCount}} 项有差异</text>
          </view>
          <view class="pc-badge {{s.diffCount>0?'st-pending':'st-done'}}">{{s.diffCount>0?'有差异':'账实相符'}}</view>
        </view>
        <view class="pc-meta">
          <text>{{s.operatorName}}</text><text> · {{s.timeText}}</text>
        </view>
        <view class="stk-diff" wx:for="{{s.items}}" wx:key="name" wx:for-item="it" wx:if="{{it.diff !== 0}}">
          <text>{{it.name}}</text>
          <text class="stk-diff-val {{it.diff>0?'up':'down'}}">{{it.systemQty}}→{{it.actualQty}}（{{it.diff>0?'+':''}}{{it.diff}}）</text>
        </view>
        <view class="stk-photo-row" wx:if="{{s.photoUrls && s.photoUrls.length}}">
          <image class="stk-photo-thumb" wx:for="{{s.photoUrls}}" wx:key="*this" wx:for-item="u" wx:for-index="ui"
            src="{{u}}" mode="aspectFill" bindtap="previewStkPhoto" data-urls="{{s.photoUrls}}" data-index="{{ui}}"/>
        </view>
      </view>
    </block>

    <!-- 操作记录子区 -->
    <block wx:if="{{stkSubTab==='logs'}}">
      <view class="export-hint">仓库近期操作：入库 / 出库 / 报废 / 编辑 / 删除 / 盘点</view>
      <view class="empty-tip" wx:if="{{whLogs.length === 0}}">暂无操作记录</view>
      <view class="log-row" wx:for="{{whLogs}}" wx:key="_id" wx:for-item="g">
        <view class="log-tag log-{{g.type}}">{{g.label}}</view>
        <view class="log-main">
          <text class="log-text">{{g.text}}</text>
          <text class="log-meta">{{g.who}}{{g.who ? ' · ' : ''}}{{g.timeText}}</text>
        </view>
      </view>
    </block>
  </block>
</view>

<!-- ============ AI 帮填入库弹窗 ============ -->
<view class="modal-mask" wx:if="{{showAiModal}}" bindtap="hideAiModal">
  <view class="modal" catchtap="noop">
    <view class="modal-title">🤖 AI 帮填入库</view>

    <!-- 第一步：输入文字 -->
    <block wx:if="{{aiStep === 'input'}}">
      <view class="ai-tip">用一句话写下要入库的东西，AI 帮你梳理成清单。例如：矿泉水 24 瓶，方便面 2 箱，鸡蛋 30 个</view>
      <textarea class="ai-textarea" placeholder="在这里输入…" value="{{aiText}}" bindinput="setAiText" maxlength="500"></textarea>
      <button class="submit-btn" bindtap="aiParse" loading="{{aiParsing}}" disabled="{{aiParsing}}">{{aiParsing ? 'AI 梳理中…' : '让 AI 梳理'}}</button>
      <view class="ai-or">— 或 —</view>
      <view class="ai-file-row">
        <button class="ai-file-btn" bindtap="aiPickImage" loading="{{aiParsing}}" disabled="{{aiParsing}}">📷 上传图片</button>
        <button class="ai-file-btn" bindtap="aiPickFile" loading="{{aiParsing}}" disabled="{{aiParsing}}">📄 上传文件</button>
      </view>
      <view class="ai-tip-sm">图片可拍照或从相册选；文件需从微信聊天里挑：先把 Excel/Word 发给「文件传输助手」，再来选。</view>
    </block>

    <!-- 第二步：确认清单 -->
    <block wx:if="{{aiStep === 'confirm'}}">
      <view class="ai-tip">AI 整理结果如下，可改可删，确认无误再入库。</view>

      <view class="ai-store-pick">
        <text class="ai-pick-label">存入：</text>
        <view class="ai-chips">
          <view class="ai-chip {{aiSiteId===s.id?'on':''}}" wx:for="{{tree.sites}}" wx:key="id" wx:for-item="s" bindtap="setAiSite" data-id="{{s.id}}">{{s.name}}</view>
        </view>
      </view>
      <view class="ai-store-pick" wx:if="{{aiStoreTabs.length}}">
        <text class="ai-pick-label">分库：</text>
        <view class="ai-chips">
          <view class="ai-chip {{aiStoreId===st.id?'on':''}}" wx:for="{{aiStoreTabs}}" wx:key="id" wx:for-item="st" bindtap="setAiStore" data-id="{{st.id}}">{{st.name}}</view>
        </view>
      </view>

      <view class="ai-items-head">物品 / 数量 / 规格</view>
      <view class="ai-item-row" wx:for="{{aiItems}}" wx:key="index" wx:for-item="it">
        <input class="form-input ai-ie-name" placeholder="名称" value="{{it.name}}" data-index="{{index}}" data-field="name" bindinput="setAiItemField"/>
        <input class="form-input ai-ie-qty" placeholder="数量" type="number" value="{{it.qty}}" data-index="{{index}}" data-field="qty" bindinput="setAiItemField"/>
        <input class="form-input ai-ie-spec" placeholder="规格" value="{{it.spec}}" data-index="{{index}}" data-field="spec" bindinput="setAiItemField"/>
        <view class="ai-ie-del" catchtap="removeAiItemRow" data-index="{{index}}">×</view>
      </view>
      <view class="add-type-link" bindtap="addAiItemRow">+ 再加一项</view>

      <view class="ai-btn-row">
        <button class="ai-back-btn" bindtap="aiBackToInput">‹ 重新输入</button>
        <button class="submit-btn ai-confirm-btn" bindtap="aiConfirmStockIn">确认入库</button>
      </view>
    </block>
  </view>
</view>

<!-- ============ 库存：记录补给/消耗弹窗 ============ -->
<view class="modal-mask" wx:if="{{showModal}}" bindtap="hideModal">
  <view class="modal" catchtap="noop">
    <view class="modal-title">记录物资变动</view>
    <view class="form-row">
      <text class="form-label">记录人</text>
      <text class="form-value-readonly">{{myName || '未设置身份'}}</text>
    </view>
    <view class="form-row">
      <text class="form-label">类型</text>
      <view class="radio-group">
        <view class="radio {{type=='in'?'active':''}}" bindtap="setType" data-val="in">补给 +</view>
        <view class="radio {{type=='out'?'active':''}}" bindtap="setType" data-val="out">消耗 -</view>
      </view>
    </view>
