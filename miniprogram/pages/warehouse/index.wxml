    </view>
    <view class="form-row form-row-wrap">
      <text class="form-label">原因</text>
      <view class="type-list">
        <view class="type-tag {{scrapReason==='损坏'?'active':''}}" bindtap="setScrapReason" data-val="损坏">损坏</view>
        <view class="type-tag {{scrapReason==='过期'?'active':''}}" bindtap="setScrapReason" data-val="过期">过期</view>
        <view class="type-tag {{scrapReason==='丢失'?'active':''}}" bindtap="setScrapReason" data-val="丢失">丢失</view>
        <view class="type-tag {{scrapReason==='其他'?'active':''}}" bindtap="setScrapReason" data-val="其他">其他</view>
      </view>
    </view>
    <view class="form-row">
      <text class="form-label">补充说明</text>
      <input class="form-input" placeholder="可选" bindinput="setScrapReasonNote" value="{{scrapReasonNote}}"/>
