    <view class="req-empty" wx:if="{{reqPickItems.length === 0}}">这个分库没有可领用的物品（食材等即时消耗品请在库存页直接消耗）</view>
    <view class="req-pick-row" wx:for="{{reqPickItems}}" wx:key="name" wx:for-item="it">
      <view class="req-pick-info">
        <text class="req-pick-name">{{it.name}}<text class="req-pick-spec" wx:if="{{it.spec}}"> · {{it.spec}}</text></text>
        <text class="req-pick-avail">可领 {{it.avail}}{{it.consumeMode==='approval' ? ' · 需审批' : ''}}</text>
      </view>
      <input class="form-input req-pick-qty" type="number" placeholder="0" data-index="{{index}}" bindinput="setReqItemQty" value="{{it.input}}"/>
    </view>

