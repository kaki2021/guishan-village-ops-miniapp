      <input class="form-input" placeholder="如：238.50" type="digit" bindinput="setReportAmount" value="{{reportAmount}}"/>
    </view>
    <view class="screenshot-row">
      <text class="screenshot-label">凭证</text>
      <view class="screenshot-picker">
        <view class="screenshot-item" wx:for="{{reportReceiptUrls}}" wx:key="*this">
          <image class="screenshot-img" src="{{item}}" mode="aspectFill" bindtap="previewReportReceipt" data-index="{{index}}"/>
          <view class="screenshot-remove" catchtap="removeReportReceipt" data-index="{{index}}">×</view>
        </view>
        <view class="screenshot-add" bindtap="chooseReportReceipts">+</view>
      </view>
