.page { padding: 24rpx 28rpx 60rpx; background: #f5f5f0; min-height: 100vh; box-sizing: border-box; }

.head { display: flex; align-items: center; justify-content: space-between; padding: 8rpx 0 16rpx; }
.head-title { font-size: 38rpx; font-weight: 600; color: #2a2a2a; }
.head-close { font-size: 28rpx; color: #1a7a5e; padding: 8rpx 12rpx; }

.intro { font-size: 24rpx; color: #999; line-height: 1.6; margin-bottom: 24rpx; }

.summary { font-size: 26rpx; color: #c0392b; margin-bottom: 16rpx; }
.summary.all-done { color: #1a7a5e; }

.empty-tip { text-align: center; color: #aaa; font-size: 28rpx; padding: 80rpx 0; }

.day-card { background: #fff; border-radius: 20rpx; padding: 24rpx; margin-bottom: 20rpx; border-left: 8rpx solid #e0e0e0; }
.day-card.done { border-left-color: #1a7a5e; }
.day-card.missed { border-left-color: #e74c3c; background: #fdf3f2; }
.day-card.todo { border-left-color: #e6a23c; }

.day-head { display: flex; align-items: center; justify-content: space-between; }
.day-label { display: flex; align-items: center; gap: 12rpx; }
.day-name { font-size: 30rpx; font-weight: 500; color: #2a2a2a; }
.day-badge { font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 8rpx; }
.done-badge { background: #e6f4ee; color: #1a7a5e; }
.missed-badge { background: #fde2e0; color: #c0392b; }
.todo-badge { background: #fdf0dd; color: #b3791f; }

.ck-btn { background: #1a7a5e; color: #fff; font-size: 26rpx; padding: 10rpx 32rpx; border-radius: 999rpx; }

.missed-tip { font-size: 22rpx; color: #c0392b; margin-top: 12rpx; }

.sec { margin-top: 18rpx; }
.sec-label { font-size: 24rpx; color: #888; }
.line { font-size: 26rpx; color: #444; line-height: 1.8; }
.line.duty { color: #1a7a5e; }
.empty-day { font-size: 24rpx; color: #bbb; }
